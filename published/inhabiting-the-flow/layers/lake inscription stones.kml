        "gx_media_links": "https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKtRHa19HAHwir2oASeWuY4DEK9CUmEGRmUSAh3cm4ezkAOC-XUjruopQJ-J5NLrpt-jJ6LheizpOiFTMouazTlAuYuX2-_CqYTRKlYfdJ0xv90SBftL9ecWLdyOXu8dwwy7jC8QKDIk-cvcKk6mg58veJLEZLsdYYfwIi8TBPVXosLFca5Cimx0GEPJ2BZkc56-1bEt?authuser=0&fife=s16383",
