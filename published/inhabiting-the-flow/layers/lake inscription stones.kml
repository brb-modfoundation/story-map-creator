        "gx_media_links": "https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKufNKrHpUykVotzF3hx_42Vcw0FJmvc25d3yLT0ZYjrC2SWRBwoWX5v2LZFlld3qN0L_hLibNrrg6wTa-ExMbYApwgK2jjRzilrH5hc4EkoPugruNepqv7YxyiEsTzpXXYVLb-fSlO0wpqtfbRM-dl_jdws7u-J_DBVuXyf1jS86mR5YrrlBnBOF00aUmTmCsZB91o?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKsWCDwRHhMH025Q2G20vtSPMt6LsgXSS6oPSn6wM4f1lY0EX5-WlswVKQcy1jP9AAueVCxgkbHXJ-XFcg5QuJiceqFdNpD-78qV8T_RsW3vjD_AWG4VxbJqrwvfnQZaeqdRkW1xlSqXntKVGPJ3dqwGXAoQ6r-sdHtbv_TiTg17c0Fv6h9PK76SwtMzjWRm66m_s3o?authuser=0&fife=s16383",
        "Epigraphia_Carnatica_Vol_9__Bangalore_Taluq_Inscription_Number": "47",
        "Hobli": "Vartur Hobli",
        "Description_of_Installed_Location_in_Historical_Record": "At Doddakannale (same hobli), in the tope in front of village",
        "English_Transliteration_Of_The_Inscription": "Front\n1.śakā-\n2. btam 1209 mē-\n3.l cellā niṉṟa vi-\n4.ya varuṣattu…..\n5. pūrva pakṣattu\n6.piṟatamaiyum ca-\n7.ṉik kiḻamaiyum\n8.tiruvōṇamum pe-\n9.ṟṟa iṟṟaināḷ sva-\n10.stišrī māmaṇṭa -\n11.līcuraṉ hariyap-\n12.pa uṭaiyaṟ pṛutdhivi\n13.irācciyam paṇ-\n14.ṇi aruḷā……\n15…..vallapa…..\n16.ṇ ṇāyakkar…….\n17…….mmaṇa…..\n18.rum veyūrnāṭṭu\n19.nāṭṭavarum irum -\n20.piliyūr mācenaṅ-\n21.kum cāṟa…mārap-\n22.panum puḷiyaṅku-\n23.ṭaiyār cokka -\n24.ppaṉuḷḷiṭṭa nā-\n25..varōm cempa -\n\nEnglish retyped text provided by S. Rajagopal <srgopal1950@gmail.com> & \nS Paranthaman <paranthaman26@gmail.com>\n",
