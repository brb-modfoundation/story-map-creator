        "Photographs_Provided_By": "Udaya Kumar P L <udayakumar.pl@gmail.com>",
        "Latitude": "12.962491",
        "Longitude": "77.635017",
        "gx_media_links": "https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKsTBICYRyLM_yIQ-hrWRkWBMNVkTH8mMfiAcmBObX4cqPZm_KX4CHVkaH15JA1d5CGLWairuz1q2YKo26msGjgAXWj7nPskKZwAbEA2dAvcYTcpiFwBN9Oh29LfL6Ji8ypLDHO7wCxTzYCTYm3nnzx6gLbe_toHXahEJnENFLS9skXsvhDQlfylhVwg7pdLJRjoCwo?authuser=0&fife=s16383",
        "Epigraphia_Carnatica_Vol_9__Bangalore_Taluq_Inscription_Number": "9",
