        "gx_media_links": "https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKtajUQSHoX9kqwFfvLciii6pOnNhY5lO_g7XdVduENea62oOIH5muKhppuol54B0Panso353dwfHjZEnb3pkFgDaItob9fZPfSIzyq2RfA2NUgawt6G3BCbkLOdguGqS9p-SRGTogO4DdXkTMNa3bMPzYnuyY580B4JRIyJXE3EBRK-9srGXhpogFfWiMrQpkcNwXk?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3ADbDBKtMzsdqY5mWD_lOc9kz2_-ktcsXXA2aenFoHfFH7_bf4K4kf_eRS7NCDGgISo0Rv47xS_3jpr3j3jkle3alGF-OZImcMtxzklgNpk260K7lfMD-RZyxxV9ZwYNeGdsNpOk-ZoffXMsRtMm9QfNhXfyeVCJ1bJQxkfiKGVy7y1_lrhV5wQDPnNhIDFozTkVjtvI0uRU?authuser=0&fife=s16383",
