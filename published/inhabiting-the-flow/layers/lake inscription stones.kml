        "Epigraphia_Carnatica_Vol_9__Bangalore_Taluq_Inscription_Number": "56",
        "Hobli": "Krishnarajapura Hobli",
        "Description_of_Installed_Location_in_Historical_Record": "At Kyalasanahalli (same hobli), on a stone in Appajappa's field",
